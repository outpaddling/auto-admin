#!/bin/sh -e

##########################################################################
#   Name:
#       auto-lock-user - Lock out a user
#
#   Section:
#       8
#
#   Synopsis:
#       auto-lock-user username
#       
#   Description:
#       The
#       .B auto-lock-user
#       command locks a user account to prevent future logins.
#       
#   Arguments:
#       username    The user to lock out of the system
#       
#   Returns:
#       0 on success, non-zero error codes otherwise.
#
#   Examples:
#       auto-lock-user jsmith
#
#   See also:
#       auto-admin(8), auto-lock-local-pw(8)
#
#   History:
#   Date        Name        Modification
#   2018-11-06  J Bacon     Begin
#   2026-10-14  Jason Bacon Add man page template and usage
##########################################################################

usage()
{
    printf "Usage: $0 user-name\n"
    exit 1
}


##########################################################################
#   Main
##########################################################################

if [ $# != 1 ]; then
    usage
fi
user_name=$1

case $(auto-ostype) in
DragonFly|FreeBSD)
    pw lock $user_name
    ;;

NetBSD)
    usermod -C yes $user_name
    ;;

RHEL)
    # FIXME: Is there a way in Linux to lock an account and restore to
    # exact config (shell and expiration date) later?
    chsh -s /sbin/nologin $user_name
    ;;

*)
    auto-unsupported-os $0
    exit 1
    ;;

esac
