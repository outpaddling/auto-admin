#!/bin/sh -e

##########################################################################
#   Script description:
#       Switch XDM on or off
#       
#   History:
#   Date        Name        Modification
#   2012-01-08  Jason Bacon Begin
##########################################################################

usage()
{
    printf "Usage: $0 on|off\n"
    exit 1
}

##########################################################################
#   Function description:
#       Toggle xdm in /etc/ttys
##########################################################################

tty_toggle()
{
    new_state=$1
    
    # In case something is left over from a crashed run
    rm -f /tmp/ttys.auto-xdm-toggle
    awk -v new_state=$new_state \
	' { if ( $2 ~ "bin/xdm" ) {
		tty=$1;
		sub("#tty","tty",tty);
		printf("%s\t%s %s\t%s\t%-3s %s\n", \
		    tty, $2, $3, $4, new_state, $6) }
	    else {
		print $0
	    }
	  }' /etc/ttys > /tmp/ttys.auto-xdm-toggle
    mv -f /tmp/ttys.auto-xdm-toggle /etc/ttys
    
    kill -HUP 1
    if [ $new_state = off ]; then
	pkill xdm || true
    fi
}

##########################################################################
#   Main
##########################################################################

if [ $# != 1 ]; then
    usage
fi

New_state=$1
case $New_state in
off|on)
    ;;
*)
    usage
    ;;
esac
    
case $(auto-ostype) in
FreeBSD)
    # xdm may be enabled as a service via rc.conf or via /etc/ttys.
    # Arbitrarily prefer the service since we have to choose one.
    # Clean up if it's enabled in both places.
    if grep -q '^xdm_enable' /etc/rc.conf; then
	# Make sure xdm is not enabled in two places.
	tty_toggle off
	if [ $New_state = off ]; then
	    service xdm stop
	else
	    service xdm start
	fi
    else
	# In case xdm_enable=YES was removed from /etc/rc.conf
	# but the service is still running.
	service xdm onestop || true
	tty_toggle $New_state
    fi
    ;;
    
*)
    auto-unsupported-os $0
    exit 1
    ;;

esac
