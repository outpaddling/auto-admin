#!/bin/sh -e

##########################################################################
#   Name:
#       auto-xdm-toggle - Start or stop the XDM display manager
#
#   Section:
#       8
#
#   Synopsis:
#       auto-xdm-toggle state
#       
#   Description:
#       The
#       .B auto-xdm-toggle
#       command starts or stops the XDM display manager, which may be
#       running from /etc/ttys or as a service using an rc(8) script.
#
#       When disabling XDM using, any graphical login sessions will be
#       abuptly terminated and any unsaved data will be lost.
#       
#   Arguments:
#       state   "on" or "off"
#       
#   Returns:
#       0 on success, non-zero error codes otherwise.
#
#   Examples:
#       auto-xdm-toggle on
#
#   Files:
#       /etc/ttys
#       /etc/rc.conf
#
#   See also:
#       auto-admin(8)
#
#   History:
#   Date        Name        Modification
#   2012-01-08  Jason Bacon Begin
#   2026-11-05  Jason Bacon Add man page template
##########################################################################

usage()
{
    printf "Usage: $0 on|off\n"
    exit 1
}


pid_clean()

{
    # Clean up in case of abnormal termination
    if [ $New_state = off ]; then
	rm -f /var/run/xdm.pid
    fi
}


##########################################################################
#   Function description:
#       Toggle xdm in /etc/ttys
##########################################################################

tty_toggle()
{
    new_state=$1
    
    # In case something is left over from a crashed run
    rm -f /tmp/ttys.auto-xdm-toggle
    awk -v new_state=$new_state \
	' { if ( $2 ~ "bin/xdm" ) {
		tty=$1;
		sub("#tty","tty",tty);
		printf("%s\t%s %s\t%s\t%-3s %s\n", \
		    tty, $2, $3, $4, new_state, $6) }
	    else {
		print $0
	    }
	  }' /etc/ttys > /tmp/ttys.auto-xdm-toggle
    mv -f /tmp/ttys.auto-xdm-toggle /etc/ttys
    
    kill -HUP 1
}


##########################################################################
#   Main
##########################################################################

if [ $# != 1 ]; then
    usage
fi

New_state=$1
case $New_state in
off|on)
    ;;
*)
    usage
    ;;
esac
    
case $(auto-ostype) in
FreeBSD)
    # xdm may be enabled as a service via rc.conf or via /etc/ttys.
    # Use rc.conf if someone has enabled xdm there, otherwise use ttys.
    # Clean up if it's enabled in both places.
    if grep -q '^xdm_enable' /etc/rc.conf; then
	# Make sure xdm is not enabled in two places.
	tty_toggle off
	if [ $New_state = off ]; then
	    service xdm stop
	    service xdm disable
	else
	    service xdm enable
	    service xdm start
	fi
    else
	# In case xdm_enable=YES was removed from /etc/rc.conf
	# but the service is still running.
	service xdm onestop || true
	tty_toggle $New_state
    fi
    pid_clean
    ;;
    
*)
    auto-unsupported-os $0
    exit 1
    ;;

esac
