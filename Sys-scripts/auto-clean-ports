#!/bin/sh -e

##########################################################################
#   Name:
#       auto-clean-ports - Remove distfiles and builds from ports tree
#
#   Section:
#       8
#
#   Synopsis:
#       auto-clean-ports
#       
#   Description:
#       The
#       .B auto-clean-ports
#       command frees up disk space by
#       removing all temporary files from a ports tree, such as
#       DragonFly dports, FreeBSD ports, and MacPorts.
#       
#   Arguments:
#       None
#       
#   Returns:
#       0 on success, non-zero error codes otherwise.
#
#   See also:
#       auto-admin(8), auto-clean-disk(8), auto-pkgsrc-clean(8),
#       auto-dreckly-clean(8)
#
#   History:
#   Date        Name        Modification
#   2026-11-12  Jason Bacon Add man page template
##########################################################################

usage()
{
    printf "Usage: $0\n"
    exit 1
}


##########################################################################
#   Main
##########################################################################

if [ $# != 0 ]; then
    usage
fi

: ${PORTSDIR:=/usr/ports}

case $(auto-ostype) in
FreeBSD)
    before=$(df -m $PORTSDIR | awk '$1 != "Filesystem" { print $4 }')
    printf "Initial free space: %d\n" $before
    cd $PORTSDIR
    rm -rf distfiles/* > /dev/null 2>&1
    for dir in $(ls -d */*/work*); do
	# Make sure it still exists - may have been wiped by a recursive clean
	if [ -e $dir ]; then
	    echo "Cleaning $dir..."
	    cd $dir/..
	    make clean
	    cd $PORTSDIR
	fi
    done
    after=$(df -m $PORTSDIR | awk '$1 != "Filesystem" { print $4 }')
    printf "Initial free space: %d\n" $before
    printf "Final free space: %d\n" $after
    diff=$(($after - $before))
    printf "%d megabytes freed.\n" $diff
    ;;

Darwin)
    port clean --all installed
    ;;

*)
    auto-unsupported-os $0
    exit 1
    ;;

esac

