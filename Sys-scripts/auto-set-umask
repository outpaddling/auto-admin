#!/bin/sh -e

##########################################################################
#   Name:
#       auto-set-umask - Change default umask for all users
#
#   Section:
#       8
#
#   Synopsis:
#       auto-set-umask umask
#       
#   Description:
#       The
#       .B auto-set-umask
#       command changes the default umask for all users.  This is typically
#       desirable on shared systems, such as HPC clusters, in order to
#       keep files private from other users by default.  The default
#       umask is commonly 022, which enables group and other read permissions
#       by default.  A umask of 027 is more appropriate where security
#       matters, allowing group read access, but denying other access.
#       
#   Arguments:
#       umask   The new umask in octal
#       
#   Returns:
#       0 on success, non-zero error codes otherwise.
#
#   Examples:
#       auto-set-umask 027
#
#   See also:
#       auto-admin(8), umask(*)
#
#   History:
#   Date        Name        Modification
#   2018-09-27  J Bacon     Begin
#   2026-11-02  Jason Bacon Add man page template and usage
##########################################################################

usage()
{
    printf "Usage: $0 octal-umask\n"
    exit 1
}


##########################################################################
#   Main
##########################################################################

if [ $# != 1 ]; then
    usage
fi

umask=$1
case `auto-ostype` in
FreeBSD)
    sed -i '' -e "s|umask=022|umask=$umask|g" /etc/login.conf
    cap_mkdb /etc/login.conf
    ;;

RHEL)
    # FIXME: How to ensure umask is set for all shells? ksh? zsh?
    for shell in sh csh; do
	printf "umask $umask\n" > /etc/profile.d/auto-umask.$shell
	chmod 644 /etc/profile.d/auto-umask.$shell
    done
    ;;

esac
