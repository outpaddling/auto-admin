#!/bin/sh -e

##########################################################################
#   Name:
#       auto-cups-setup - Install necessary software and enable CUPS service
#
#   Section:
#       8
#
#   Synopsis:
#       auto-cups-setup
#       
#   Description:
#       The
#       .B auto-cups-setup
#       command installs essential packages plus some common printer drivers,
#       and enables the CUPS printing service.
#
#       Note: CUPS will not support drivers in the future, so the driver
#       installations here are allowed to fail.
#       
#   Arguments:
#       None
#       
#   Returns:
#       0 on success, non-zero error codes otherwise.
#
#   Examples:
#       auto-cups-setup
#
#   Files:
#       PREFIX/etc/cups
#
#   See also:
#       auto-admin(8), cupsd(8), lpr(1)
#
#   History:
#   Date        Name        Modification
#   2026-11-12  Jason Bacon Add man page template
##########################################################################

usage()
{
    printf "Usage: $0\n"
    exit 1
}


##########################################################################
#   Main
##########################################################################

if [ $# != 0 ]; then
    usage
fi

case $(auto-ostype) in
FreeBSD)
    printf "Configuring cups...\n"
    auto-install-packages print/cups
    auto-mark-package-critical cups
    # Tolerate failures here, as print drivers will go away eventually.
    # CUPS will stop supporting drivers at some point, so don't mark
    # these critical.
    auto-install-packages print/brlaser print/hplip print/foomatic-db-engine \
	print/gutenprint || true

    # FIXME: Should lpt be in devfs.conf?  Forgot why I put it here.
    # Maybe just a brain fart.
    auto-update-devfs-rules cups unlpt ulpt lpt
    
    # FIXME: Is this still necessary?
    # Older ports have lpt-cupsd.conf, newer ulpt-cupsd.conf
    if [ -f $(auto-localbase)/share/examples/cups/ulpt-cupsd.conf ]; then
	if [ ! -f $(auto-localbase)/etc/devd/ulpt-cupsd.conf ]; then
	    mkdir -p $(auto-localbase)/etc/devd
	    cp $(auto-localbase)/share/examples/cups/ulpt-cupsd.conf $(auto-localbase)/etc/devd/
	fi
    
	# Fix missing semicolons in cups 1.4.6 $(auto-localbase)/etc/devd/ulpt-cupsd.conf
	if [ -e $(auto-localbase)/etc/devd/ulpt-cupsd.conf ]; then
	    sed -i '' -e 's|}$|};|g' $(auto-localbase)/etc/devd/ulpt-cupsd.conf
	fi
    elif [ -f $(auto-localbase)/share/examples/cups/lpt-cupsd.conf ]; then
	if [ ! -f $(auto-localbase)/etc/devd/lpt-cupsd.conf ]; then
	    mkdir -p $(auto-localbase)/etc/devd
	    cp $(auto-localbase)/share/examples/cups/lpt-cupsd.conf $(auto-localbase)/etc/devd/
	fi
    fi
    
    auto-enable-service cupsd $0
    ;;

*)
    auto-unsupported-os $0
    exit 1
    ;;

esac
