#!/bin/sh -e

##########################################################################
#   Name:
#       auto-change-ownership - Change ownership of select files
#
#   Section:
#       8
#
#   Synopsis:
#       auto-change-ownership [--silent] old-username|uid new-username|uid directory [directory ...]
#       
#   Description:
#       The
#       .B auto-change-ownership
#       command changes the ownership of select files/directories under one or
#       more top-level directories.  It searches under the specified directories using
#       find(1) for files/direcotries owned by the given user, and changes
#       the ownership to the new user.
#
#       This is a convenience script allowing users to avoid complicated
#       and error-prone find(1) commands.
#       
#   Arguments:
#       --silent            Option to suppress output of filenames processed
#       username|uid        Username or UID of files/directories to be changed
#       new-username|uid    New username or UID for discovered files/directories
#       directory           Top-level directory under which to search
#       
#   Returns:
#       0 on success, non-zero error codes otherwise.
#
#   Examples:
#       auto-change-ownership --silent joeuser jwuser /collab/projectX
#
#   Files:
#       /etc/passwd
#
#   See also:
#       auto-admin(8), auto-change-group-ownership(8), chown(1)
#
#   History:
#   Date        Name        Modification
#   2026-11-11  Jason Bacon Add man page template
##########################################################################

usage()
{
    printf "Usage: $0 [--silent] old-username|uid new-username|uid directory [directory ...]\n"
    exit 1
}


##########################################################################
#   Main
##########################################################################

if [ $# -lt 3 ]; then
    usage
fi

if [ $1 = --silent ]; then
    shift
    verbose=""
else
    verbose=-v
fi

old_user=$1
new_user=$2
shift
shift

dirs="$@"

# BSD and GNU find allow a name or id with -user and -group.
# GNU find requires a UID with -uid or -gid.  Use -user and -group to
# be flexible and portable.
find $dirs -fstype nfs -prune -o \
    -user $old_user -exec chown $verbose -h $new_user '{}' +
