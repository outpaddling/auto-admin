#!/bin/sh -e

##########################################################################
#   Name:
#       auto-write-cache-toggle - Enable or disable the CAM write cache
#
#   Section:
#       8
#
#   Synopsis:
#       auto-write-cache-toggle state caller
#       
#   Description:
#       The
#       .B auto-write-cache-toggle
#       command enables or disables the CAM(4) storage driver.
#
#       Disabling the cache will seriously degrade write performance
#       and increase wear on the storage device, but
#       may prevent filesystem corruption and data loss in the event of
#       a power failure.  This should be used only where data integrity
#       far outweighs performance.
#
#       If the variable controlling write cache activity
#       was not already in the configuration file, an entry is added.
#       If caller is not "nocomment", the new entry is wrapped in a
#       comment as follows:
#
#       .nf
#       .na
#       # Added by auto-admin from $caller
#       var=value
#       # End $caller addition
#       .ad
#       .fi
#
#   Arguments:
#       state   "on" or "off"
#       caller  Name of the calling program, usually "$0" if run from a script
#       
#   Returns:
#       0 on success, non-zero error codes otherwise.
#
#   Examples:
#       auto-write-cache-toggle
#
#   Files:
#       /boot/loader.conf
#
#   See also:
#       auto-admin(8), CAM(4), loader.conf(4)
#
#   History:
#   Date        Name        Modification
#   2020-05-14  J Bacon     Begin
#   2026-11-05  Jason Bacon Add man page template
##########################################################################

usage()
{
    printf "Usage: $0 on|off calling-program|'nocomment'\n"
    exit 1
}


##########################################################################
#   Main
##########################################################################

if [ $# != 2 ]; then
    usage
fi

if [ $1 = on ]; then
    state=1
elif [ $1 = off ]; then
    state=0
else
    usage
fi
caller="$2"

auto-root-check $0

case $(auto-ostype) in
FreeBSD)
    auto-set-conf-var kern.cam.ada.write_cache $state /boot/loader.conf $caller
    printf "Write cache will be $1 after the next reboot.\n"
    ;;

*)
    auto-unsupported-os $0
    exit 1
    ;;

esac
