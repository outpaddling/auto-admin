#!/bin/sh -e

##########################################################################
#   Name:
#       auto-fusefs-install - Install and enable fusefs
#
#   Section:
#       8
#
#   Synopsis:
#       auto-fusefs-install
#       
#   Description:
#       The
#       .B auto-fusefs-install
#       command installs the necessary packages for common fusefs-supported
#       filesystems and enables the fusefs system.
#       
#   Arguments:
#       None
#       
#   Returns:
#       0 on success, non-zero error codes otherwise.
#
#   Examples:
#       auto-fusefs-install
#
#   See also:
#       auto-admin(8), fusefs(5)
#
#   History:
#   Date        Name        Modification
#   2026-11-25  Jason Bacon Add man page template
##########################################################################

usage()
{
    printf "Usage: $0\n"
    exit 1
}


##########################################################################
#   Main
##########################################################################

if [ $# != 0 ]; then
    usage
fi

case $(auto-ostype) in
FreeBSD)
    pkg install -y fusefs-libs \
    exfat-utils fusefs-exfat fusefs-ntfs fusefs-ext2 fusefs-lkl \
	fusefs-hfsfuse fusefs-simple-mtpfs
    kldload fusefs || true
    sysrc kld_list+=fusefs
    ;;

NetBSD)
    # FreeBSD uses fuse-lkl for ext4, NetBSD fuse-ext2 (2023-06)
    pkgin -y fuse fuse-exfat install fuse-ntfs fuse-ext2
    
    # FIXME: How to enable fuse on NetBSD?
    #kldload fusefs || true
    #sysrc kld_list+=fusefs
    ;;

*)
    auto-unsupported-os $0
    exit 1
    ;;

esac
