#!/bin/sh -e

##########################################################################
#   Name:
#       auto-unsupported-release - Display a user-friendly message for unsupported OS releases
#
#   Section:
#       8
#
#   Synopsis:
#       auto-unsupported-release command
#       
#   Description:
#       The
#       .B auto-unsupported-release
#       command displays a user-friendly message stating the the
#       calling script does not support this release of the operating
#       system running it.
#       This is used by some auto-admin scripts where a particular
#       operating system release lacks a necessary feature.
#       
#   Arguments:
#       command     Name of the calling command, usually $0
#       
#   Returns:
#       0 on success, non-zero error codes otherwise.
#
#   Examples:
#       auto-unsupported-release $0
#
#   See also:
#       auto-admin(8), auto-unsupported-os(8), auto-os-release(8)
#
#   History:
#   Date        Name        Modification
#   2021-10-26  Jason Bacon Begin
#   2026-11-04  Jason Bacon Add man page template and usage
##########################################################################

usage()
{
    printf "Usage: $0 unsupported-program-name\n"
    exit 1
}


##########################################################################
#   Main
##########################################################################

if [ $# != 1 ]; then
    usage
fi
unsupported_prog=`basename $1`

cat << EOM

${unsupported_prog}: Not currently supported on $(auto-os-release)

Adding support for $unsupported_prog on $(auto-os-release) may be a simple matter
of adding a case to $unsupported_prog or even just adding "|$(auto-os-release)"
to an existing case if the code is the same as on a currently supported OS.

Please consider helping the open source community by adding and fully testing
support for $(auto-os-release) and submitting a patch (e.g. on Github.)

EOM
