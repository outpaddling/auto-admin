#!/bin/sh -e

##########################################################################
#   Name:
#       auto-unlock-local-pw - Allow a user to log in via a local password
#
#   Section:
#       8
#
#   Synopsis:
#       auto-unlock-local-pw username
#       
#   Description:
#       The
#       .B auto-unlock-local-pw
#       command allows a user to log in via a local password.
#
#       Note that the user may still be able to log in via remote
#       authentication services such as ldap(3), or AD (active directory).
#       
#   Arguments:
#       username    The user to unlock
#       
#   Returns:
#       0 on success, non-zero error codes otherwise.
#
#   Examples:
#       auto-unlock-local-pw joeuser
#
#   Files:
#       /etc/passwd, /etc/master.passwd, /etc/shadow
#
#   See also:
#       auto-admin(8), auto-lock-local-pw(8), auto-lock-user(8),
#       auto-unlock-user(8), pw(8), passwd(1)
#
#   History:
#   Date        Name        Modification
#   2019-06-25  Jason Bacon Begin
#   2026-11-03  Jason Bacon Add man page template and usage
##########################################################################

usage()
{
    printf "Usage: $0 username\n"
    exit 1
}


##########################################################################
#   Main
##########################################################################

if [ $# != 1 ]; then
    usage
fi
user_name=$1

case $(auto-ostype) in
FreeBSD)
    # pw lock blocks all authentication methods, so just munge the pw manually
    # with a !! to disable the local password.
    pw=$(awk -F : -v user_name=$user_name '$1 == user_name { print $2 }' /etc/master.passwd)
    printf "${pw#!!}\n" | pw usermod $user_name -H 0
    printf "Don't forget to set password expiration with pw if needed.\n"
    ;;

RHEL)
    # passwd -l only blocks local password.  LDAP, AD, etc will still work.
    passwd -u $user_name
    printf "Don't forget to set password expiration with chage if needed.\n"
    ;;

*)
    auto-unsupported-os $0
    exit 1
    ;;

esac
