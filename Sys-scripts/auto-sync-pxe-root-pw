#!/bin/sh -e

##########################################################################
#   Name:
#       auto-sync-pxe-root-pw - Copy the root password from PXE install image
#
#   Section:
#       8
#
#   Synopsis:
#       auto-sync-pxe-root-pw
#       
#   Description:
#       The
#       .B auto-sync-pxe-root-pw
#       command
#       syncs the root password in a PXE install image to the
#       current root account.  This is used to automatically set the
#       root password following a PXE operating system installation.
#       The PXE installer image must be in a standard location, as
#       when created by auto-pxe-installer-setup(8).
#       
#   Arguments:
#       None
#       
#   Returns:
#       0 on success, non-zero error codes otherwise.
#
#   Files:
#       LOCALBASE/etc/auto-admin/pxe, /etc/master.passwd
#
#   See also:
#       auto-admin(8), auto-pxe-installer-setup(8), passwd(1),
#       auto-transfer-pw(8)
#
#   History:
#   Date        Name        Modification
#   2021-12-23  J Bacon     Begin
#   2026-11-03  Jason Bacon Add man page template and usage
##########################################################################

usage()
{
    printf "Usage: $0\n"
    exit 1
}


##########################################################################
#   Main
##########################################################################

if [ $# != 0 ]; then
    usage
fi

case $(auto-ostype) in
FreeBSD)
    : ${LOCALBASE:=/usr/local}
    
    rootpw=$(awk -F : '$1 == "root" { print $2 }' /etc/master.passwd)
    #echo $rootpw
    prefix=$(awk '$1 == "prefix" { print $2 }' $LOCALBASE/etc/auto-admin/pxe)
    for dir in $prefix/images/*; do
	# No auto-transfer-pw under chroot, use chpass/usermod directly
	chroot $dir chpass -p "$rootpw" root
	#awk -F : '$1 == "root" { print $2 }' $dir/etc/master.passwd
    done
    ;;

*)
    auto-unsupported-os $0
    ;;

esac
