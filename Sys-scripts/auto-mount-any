#!/bin/sh -e

##########################################################################
#   Name:
#       auto-mount-any - Mount a filesystem of unknown type
#
#   Section:
#       8
#
#   Synopsis:
#       auto-mount-any /dev/device mount-point
#       
#   Description:
#       The
#       .B auto-mount-any
#       command attempts to mount /dev/device on mount-point, assuming
#       common filesystem types, until it succeeds or runs out of
#       options.
#       
#   Arguments:
#       /dev/device     Device file denoting the partition containing the filesystem
#       mount-point     Empty directory under which the device should be mounted
#       
#   Returns:
#       0 on success, non-zero error codes otherwise.
#
#   Examples:
#       auto-mount-any /dev/da0p1 /media/usb-stick
#
#   See also:
#       auto-admin(8), mount(8)
#
#   History:
#   Date        Name        Modification
#   2015-12-27  J Bacon     Begin
#   2026-10-14  Jason Bacon Add man page template and usage
##########################################################################


usage()
{
    printf "Usage: $0 device mount-point\n"
    exit 1
}


##########################################################################
#   Main
##########################################################################

if [ $# != 2 ]; then
    usage
fi

dev=$1
mount_point=$2
    
case $(auto-ostype) in
FreeBSD)
    # Try mounting various filesystems
    for fs in ufs msdosfs ntfs cd9660; do
	if mount -t $fs $dev $mount_point; then
	    printf "Mounted $fs.\n"
	    exit 0
	fi
    done
    
    printf "Unable to mount: Unknown filesystem.\n"
    exit 1
    ;;
    
*)
    auto-unsupported-os $0
    exit 1
    ;;

esac
