#!/bin/sh -e

##########################################################################
#   Name:
#       auto-lock-local-pw - Lock local password for a user
#
#   Section:
#       8
#
#   Synopsis:
#       auto-lock-local-pw username
#       
#   Description:
#       The
#       .B auto-lock-local-pw
#       command disables the local password for user, so they must authenticate
#       using a service such as LDAP or AD.
#       
#   Arguments:
#       username    Username of the user to lock
#       
#   Returns:
#       0 on success, non-zero error codes otherwise.
#
#   Examples:
#       auto-lock-local-pw
#
#   See also:
#       auto-admin(8), auto-unlock-local-pw(8)
#
#   History:
#   Date        Name        Modification
#   2019-06-25  J Bacon     Begin
#   2026-10-14  Jason Bacon Add man page template and usage
##########################################################################

usage()
{
    printf "Usage: $0 username\n"
    exit 1
}


##########################################################################
#   Main
##########################################################################

if [ $# != 1 ]; then
    usage
fi
user_name=$1

case $(auto-ostype) in
FreeBSD)
    # pw lock blocks all authentication methods, so just munge the pw manually
    # with a !! to disable the local password.
    pw=$(awk -F : -v user_name=$user_name '$1 == user_name { print $2 }' /etc/master.passwd)
    printf "!!$pw\n" | pw usermod $user_name -H 0
    # FIXME: Is there a way to disable password expiration, e.g. +0?
    # Should be, but man page is unclear
    pw usermod $user_name -p +20y
    ;;

RHEL)
    # passwd -l only blocks local password.  LDAP, AD, etc will still work.
    passwd -l $user_name
    # Linux still tracks password age even if the password is locked
    chage -M -1 $user_name
    ;;

*)
    auto-unsupported-os $0
    exit 1
    ;;

esac
