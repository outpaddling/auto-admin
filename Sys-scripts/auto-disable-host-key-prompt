#!/bin/sh -e

##########################################################################
#   Name:
#       auto-disable-host-key-prompt - Disable ssh warning for unknown host key
#
#   Section:
#       8
#
#   Synopsis:
#       auto-disable-host-key-prompt short-hostname long-hostname IP
#       
#   Description:
#       The
#       .B auto-disable-host-key-prompt
#       command disables the ssh warning for an unknown host key when
#       connecting to the given host for the first time.
#
#       This is useful on a local area network where certain hosts can
#       be implicitely trusted, rather than forcing every user to authorize
#       connections to every host, which is default ssh behavior.
#       Clusters and grids are prime examples where the warning is
#       undesirable.
#       
#   Arguments:
#       short-hostname  Short hostname of the target host
#       long-hostname   Fully qualified domain name of the target host
#       IP              IP address of the target host
#       
#   Returns:
#       0 on success, non-zero error codes otherwise.
#
#   Examples:
#       auto-disable-host-key-prompt compute-001 compute-001.cluster.edu 192.168.0.10
#
#   Files:
#       /etc/ssh/ssh_config
#
#   See also:
#       auto-admin(8), auto-ssh-authorize(8), auto-ssh-reverse-authorize(8)
#
#   History:
#   Date        Name        Modification
#   2018-08-16  J Bacon     Begin
#   2026-11-13  Jason Bacon Add man page template
##########################################################################

usage()
{
    printf "Usage: $0 short-hostname long-hostname IP\n"
    exit 1
}


##########################################################################
#   Main
##########################################################################

# FIXME: Maybe allow specifying just one if the rest can be resolved?
if [ $# != 3 ]; then
    usage
fi

short_name=$1
host_name=$2
new_ip=$3

if [ $(auto-ostype) = FreeBSD ]; then
    if ! which gsed > /dev/null 2>&1; then
	pkg install -y gsed
    fi
    sed=gsed
elif [ -e /etc/redhat-release ]; then
    sed=sed
else
    # Not certain that /etc/ssh is always the right directory
    auto-unsupported-os $0
    exit 1
fi

auto-backup-file /etc/ssh/ssh_config

# FIXME: Inadequate test to avoid redundant entries
if ! fgrep -wq $host_name /etc/ssh/ssh_config; then
    $sed -i'' "2i\ " /etc/ssh/ssh_config
    $sed -i'' "3iHost $short_name" /etc/ssh/ssh_config
    $sed -i'' '4i\\tStrictHostKeyChecking no' /etc/ssh/ssh_config
    $sed -i'' "5iHost $host_name" /etc/ssh/ssh_config
    $sed -i'' '6i\\tStrictHostKeyChecking no' /etc/ssh/ssh_config
    $sed -i'' "7iHost $new_ip" /etc/ssh/ssh_config
    $sed -i'' '8i\\tStrictHostKeyChecking no' /etc/ssh/ssh_config
fi
