#!/bin/sh -e

##########################################################################
#   Name:
#       auto-update-devfs-rules - Add entries to devfs.rules
#
#   Section:
#       8
#
#   Synopsis:
#       auto-update-devfs-rules driver [driver ...]
#       
#   Description:
#       The
#       .B auto-update-devfs-rules
#       command adds one or more entries to /etc/devfs.rules.
#       It is used by tools such as desktop-installer to augment the
#       default set of devices available to users.  The system file
#       /etc/devfs.rules lists device files (e.g. /dev/ugen0.1)
#       that should be automatically created when plugged into a
#       running system, and indicates the
#       ownership and permissions of each device file.
#       This command is specific to FreeBSD.
#       The devfs daemon is restarted in order to affect the changes.
#       The driver name is the stem of each device name under /dev.
#       E.g., the "cd" driver supports devices such as /dev/cd0 and /dev/cd1.
#       
#   Arguments:
#       driver  Name of a pluggable device driver
#       
#   Returns:
#       0 on success, non-zero error codes otherwise.
#
#   Examples:
#       auto-update-devfs-rules cd da pass xpt mmcsd
#
#   Files:
#       /etc/devfs.rules
#
#   See also:
#       auto-admin(8), auto-update-devfs-conf(8), devfs(8), devfs.rules(8)
#
#   History:
#   Date        Name        Modification
#   2021-11-11  Jason Bacon Begin
#   2026-11-04  Jason Bacon Add man page template and usage
##########################################################################

usage()
{
    printf "Usage: $0 group device [device ...]\n"
    exit 1
}


##########################################################################
#   Main
##########################################################################

if [ $# -lt 2 ]; then
    usage
fi

case $(auto-ostype) in
FreeBSD)
    : ${DEVFS_RULES:=/etc/devfs.rules}
    : ${RC_CONF:=/etc/rc.conf}
    
    if [ ! -e $DEVFS_RULES ]; then
	printf "[system=10]\n" > $DEVFS_RULES
    fi
    
    auto-enable-service devd desktop-installer
    auto-set-conf-var devfs_system_ruleset '"system"' $RC_CONF desktop-installer
    
    group=$1
    shift
    for dev in $*; do
	if ! fgrep -qw "'${dev}*'" $DEVFS_RULES; then
	    printf "Adding $dev to defvs.rules.\n"
	    printf "# Added by desktop-installer.\n" >> $DEVFS_RULES
	    printf "add path '${dev}*' mode 0660 group $group\n" >> $DEVFS_RULES
	else
	    printf "Entry already exists in devfs.rules for $dev.\n"
	fi
    done
    service devfs restart
    ;;

*)
    auto-unsupported-os $0
    exit 1
    ;;

esac
