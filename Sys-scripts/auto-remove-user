#!/bin/sh -e

##########################################################################
#   Name:
#       auto-remove-user - Remove a user
#
#   Section:
#       8
#
#   Synopsis:
#       auto-remove-user [-r|--remove-home] [-y|--yes]
#       
#   Description:
#       The
#       .B auto-remove-user
#       command removes a user account and possibly their home directory.
#       It presents prompts before removing the user and before removing
#       the directory, unless -r|--remove-home or -y|--yes are provided
#       on the command-line.
#       
#   Arguments:
#       -r|--remove-home    Remove home directory without asking
#       -y|--yes            Remove user without asking
#       
#   Returns:
#       0 on success, non-zero error codes otherwise.
#
#   Examples:
#       auto-remove-user -ry joeuser
#
#   See also:
#       auto-admin(8), auto-adduser(8), auto-useradd(8)
#
#   History:
#   Date        Name        Modification
#   2018-11-06  J Bacon     Begin
#   2026-10-27  Jason Bacon Add man page template and usage
##########################################################################

usage()
{
    printf "Usage: $0 [-r|--remove-home] [-y|--yes] user-name\n"
    printf "-r|--remove-home = remove home directory\n"
    printf "-y|--yes = do not prompt before removal\n"
    exit 1
}


##########################################################################
#   Main
##########################################################################

if [ $# -lt 1 ]; then
    usage
fi

while [ $# -gt 1 ]; do
    case $1 in
    '-r'|'--remove-home')
	remove_home=1
	shift
	;;
    '-y'|'--yes')
	no_prompt=1
	shift
	;;
    '-ry'|'-yr')
	remove_home=1
	no_prompt=1
	shift
	;;
    *)
	usage
	;;
    esac
done

user_name=$1
home_dir=$(awk -F : -v user_name=$user_name '$1 == user_name { print $6 }' /etc/passwd)

if [ 0$no_prompt != 01 ]; then
    printf "Are you sure you want to remove $user_name? yes/[no] "
    read remove
    if [ 0$remove != 0yes ]; then
	exit 0
    fi
    
    if [ 0$remove_home != 01 ]; then
	printf "Remove home directory? yes/[no] "
	read resp
	if [ 0$resp = 0yes ]; then
	    remove_home=1
	fi
    fi
fi

case $(auto-ostype) in
FreeBSD)
    rmuser -y $user_name
    ;;

RHEL)
    userdel $user_name || true
    ;;

*)
    auto-unsupported-os $0
    exit 1
    ;;

esac

if [ 0$remove_home = 01 ]; then
    printf "Removing $home_dir...\n"
    rm -rf $home_dir
fi
