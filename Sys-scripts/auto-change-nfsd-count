#!/bin/sh -e

##########################################################################
#   Name:
#       auto-change-nfsd-count - Change the number of nfsd(8) processes/threads
#
#   Section:
#       8
#
#   Synopsis:
#       auto-change-nfsd-count minimum maximum
#       
#   Description:
#       The
#       .B auto-change-nfsd-count
#       command sets the minimum and maximum number of nfsd(1) processes
#       or threads.  Some systems, such as FreeBSD, use threads and 
#       dynamically adjust the number of threads to meet load.
#       Others, such as RHEL, use a fixed number of heavyweight processes,
#       in which case the "minimum" argument is ignored, and the number
#       of processes will be the "maximum" argument.
#       
#   Arguments:
#       minimum     The minimum number of NFS server processes to keep running
#       maximum     The maximum number of NFS server processes to run
#       
#   Returns:
#       0 on success, non-zero error codes otherwise.
#
#   Examples:
#       auto-change-nfsd-count
#
#   Files:
#       /etc/exports
#
#   See also:
#       auto-admin(8), auto-autofs-nfs-setup(8), auto-nfs-add-share(8),
#       auto-nfs-restart(8), auto-nfs-client-setup(8), auto-nfs-server-setup(8),
#       nfsd(8), rpc.mountd(8), rpc.lockd(8)
#
#   History:
#   Date        Name        Modification
#   2026-11-10  Jason Bacon Add man page template
##########################################################################

usage()
{
    printf "Usage: $0 min-server-count max-server-count\n"
    exit 1
}


##########################################################################
#   Main
##########################################################################

if [ $# != 2 ]; then
    usage
fi

min_count=$1
max_count=$2

case $(auto-ostype) in
FreeBSD)

    # Add/update --minthreads, remove -n count if present
    if egrep -q 'nfs_server_flags.*-n [0-9]+' /etc/rc.conf; then
	sed -i '' -E "/^nfs_server_flags/s|-n [0-9]+|--minthreads $min_count|g" /etc/rc.conf
    elif egrep -q 'nfs_server_flags.*--minthreads [0-9]+' /etc/rc.conf; then
	sed -i '' -E "/^nfs_server_flags/s|--minthreads [0-9]+|--minthreads $min_count|g" /etc/rc.conf
    else
	sysrc nfs_server_flags+=" --minthreads $min_count"
    fi
    
    # Add/update --maxthreads
    if egrep -q 'nfs_server_flags.*--maxthreads [0-9]+' /etc/rc.conf; then
	sed -i '' -E "/^nfs_server_flags/s|--maxthreads [0-9]+|--maxthreads $max_count|g" /etc/rc.conf
    else
	sysrc nfs_server_flags+=" --maxthreads $max_count"
    fi
    ;;

RHEL)
    printf "Info: Using $max_count as RHEL does not support min/max.\n"
    sed -i'' -e "s|.*RPCNFSDCOUNT=.*|RPCNFSDCOUNT=$max_count|g" /etc/sysconfig/nfs
    systemctl restart nfs
    ;;

*)
    auto-unsupported-os $0
    exit 1
    ;;

esac
auto-nfs-restart
