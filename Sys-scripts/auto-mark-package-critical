#!/bin/sh -e

##########################################################################
#   Name:
#       auto-mark-package-critical - Mark a package as critical for updates
#
#   Section:
#       8
#
#   Synopsis:
#       auto-mark-package-critical pkgname
#       
#   Description:
#       The
#       .B auto-mark-package-critical
#       command marks a package as critical for system updates.
#       The auto-update-system(8) command will then warn the user
#       if this package is missing from the repository before proceeding
#       with pkg-upgrade(8).
#
#       This should be used for packages that are essential to normal
#       system function, such as a desktop-environment, and applications
#       that are used on a daily basis.  The desktop-installer(1) script
#       automatically marks the chosen desktop environment and several
#       other packages.
#       
#   Arguments:
#       pkgname     The name of the package as specified to pkg(8)
#       
#   Returns:
#       0 on success, non-zero error codes otherwise.
#
#   Examples:
#       auto-mark-package-critical firefox
#
#   See also:
#       auto-admin(8), auto-mark-install-from-source(8)
#
#   History:
#   Date        Name        Modification
#   2026-10-14  Jason Bacon Add man page template and usage
##########################################################################

##########################################################################
#   Script description:
#       Mark a package critical for auto-update-system
#       
#   History:
#   Date        Name        Modification
#   2020-08-13  Jason Bacon Begin
##########################################################################

usage()
{
    printf "Usage: $0 --list | package [package ...]\n"
    exit 1
}


##########################################################################
#   Main
##########################################################################

if [ $# -lt 1 ]; then
    usage
fi

case $(auto-ostype) in
DragonFly|FreeBSD)
    if [ $1 == --list ]; then
	cat $(auto-localbase)/etc/auto-admin/critical-packages
	exit 0
    fi
    mkdir -p $(auto-localbase)/etc/auto-admin
    for pkg in "$@"; do
	auto-append-line $pkg $(auto-localbase)/etc/auto-admin/critical-packages nocomment
    done
    if ! pkg info -q $pkg; then
	printf "Warning: $pkg is not currently installed.\n"
	exit 1
    fi
    ;;

*)
    # FIXME: Can this be merged with the FreeBSD case?
    # auto-pkgsrc-prefix exits non-zero if no tree found
    PKGSRC=$(auto-pkgsrc-prefix) || true
    if [ -z "$PKGSRC" ]; then
	printf "$0: No active pkgsrc tree found.\n"
	exit 1
    fi
    mkdir -p $PKGSRC/etc/auto-admin
    for pkg in "$@"; do
	auto-append-line $pkg $PKGSRC/etc/auto-admin/critical-packages nocomment
    done
    
    # FIXME: Exit non-zero if package is not installed
    # Add support to auto-package installed?
    ;;

esac
