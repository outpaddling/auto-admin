#!/bin/sh -e

##########################################################################
#   Name:
#       auto-set-conf-var - Set a variable in a configuration file
#
#   Section:
#       8
#
#   Synopsis:
#       auto-set-conf-var variable value file caller
#       
#   Description:
#       The
#       .B auto-set-conf-var
#       command adds or changes the value of a variable in a configuration
#       file such as /etc/sysctl.conf, /boot/loader.conf, or any other file
#       containing entries of the form "variable=value".
#
#       It provides a controlled and non-interactive alternative to manually
#       editing files, and a portable, file-agnostic alternative to
#       system-specific interfaces such as FreeBSD's sysrc(8).
#
#       If the variable was not previously present in the configuration file,
#       the added entry is wrapped in a comment as follows:
#
#       .nf
#       .na
#       # Added by auto-admin from $caller
#       var=value
#       # End $caller addition
#       .ad
#       .fi
#
#   Arguments:
#       variable    Variable to add or change
#       value       New value of variable
#       file        Absolute path of the configuration file
#       caller      Name of calling script, often "$0"
#       
#   Returns:
#       0 on success, non-zero error codes otherwise.
#
#   Examples:
#       auto-set-conf-var acpi_video_load '"YES"' /boot/loader.conf $0
#
#   Files:
#       /etc/sysctl.conf, /boot/loader.conf
#
#   See also:
#       auto-admin(8), auto-append-line(8)
#
#   History:
#   Date        Name        Modification
#   2020-05-14  Jason Bacon Begin
#   2026-10-31  Jason Bacon Add man page template and usage
##########################################################################

usage()
{
    printf "Usage: $0 variable value file calling-program|'nocomment'\n"
    exit 1
}


##########################################################################
#   Main
##########################################################################

if [ $# != 4 ]; then
    usage
fi

variable="$1"
value="$2"
file="$3"
caller="$4"

if [ ! -e $file ]; then
    printf "$0: $file does not exist.\n"
    exit 1
fi

case $(uname) in
NetBSD)
    in_place="-i''"
    ;;

*)
    in_place="-i ''"
    ;;

esac

if grep -q "^$variable=" $file; then
    sed $in_place -e "s|^$variable=.*|$variable=$value|" $file
else
    auto-append-line "$variable=$value" $file $caller
fi
