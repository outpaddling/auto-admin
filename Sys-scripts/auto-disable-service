#!/bin/sh -e

##########################################################################
#   Name:
#       auto-disable-service - Disable a service
#
#   Section:
#       8
#
#   Synopsis:
#       auto-disable-service service-name
#       
#   Description:
#       The
#       .B auto-disable-service
#       command disables a service.  It is primarily a compatibility layer
#       to mask the extensive differences in how services are handled
#       between various Unix platforms such as BSD, Linux, and macOS.
#       This makes it possible to write portable code that manipulate
#       services, assuming the service has the same name across platforms,
#       as is often the case.
#
#       Note: The service name used here is the name of the service
#       as specified to underlying native commands such as "service"
#       or "systemctl".
#       
#   Arguments:
#       service-name    Name of the service
#       
#   Returns:
#       0 on success, non-zero error codes otherwise.
#
#   Examples:
#       auto-disable-service sshd
#
#   See also:
#       auto-admin(8), auto-enable-service(8), auto-restart-services(8),
#       auto-services-manager(8), auto-service-enabled(8)
#
#   History:
#   Date        Name        Modification
#   2026-11-14  Jason Bacon Add man page template
##########################################################################

usage()
{
    if [ $(uname) = Darwin ]; then
	printf "Usage: $0 plist-name[.plist]\n"
    else
	printf "Usage: $0 rc.conf-name\n"
    fi
    exit 1
}


##########################################################################
#   Main
##########################################################################

if [ $# != 1 ]; then
    usage
fi
    
case $(auto-ostype) in
DragonFly)
    service=$1
    service $service stop || true
    for dir in /etc/rc.d /usr/local/etc/rc.d; do
	if [ -e $dir/$script ]; then
	    if grep -q '^rcvar=' $dir/$script; then
		rcvar=$(grep '^rcvar=' $dir/$script | tail -1 | cut -d = -f 2)
	    else
		rcvar=$script
	    fi
	    printf "rc service name = $rcvar\n"
	    break
	fi
    done
    if ! which sysrc; then
	pkg install -y sysrc
    fi
    sysrc $rcvar=NO
    ;;

FreeBSD)
    service=$1
    service $service stop || true
    service $service disable || true
    ;;

NetBSD)
    service=$1
    service $service stop || true
    if auto-service-enabled $service; then
	sed -I'.bak' -e "s|^${service}=.*$|${service}=NO|" /etc/rc.conf
    fi
    ;;
    
Darwin)
    service="$1"
    dir=/Library/LaunchDaemons
    # Full name of plist file was provided, e.g. org.pkgsrc.lpjs_compd.plist
    if [ -e $dir/$service ]; then
	plist=$dir/$service
    # Just the service name, e.g. lpjs_compd
    elif [ -e $dir/org.pkgsrc.$service.plist ]; then
	plist=$dir/org.pkgsrc.$service.plist
    else
	printf "$service is not installed in $dir.\n"
	exit 0
    fi
    
    printf "Stopping service $plist...\n"
    launchctl stop $plist || true
    
    if [ -e $plist ]; then
	printf "Disabling service $plist...\n"
	if ! launchctl bootout system $plist; then
	    printf "Is $plist already disabled?\n" >> /dev/stderr
	fi
	rm -f $plist
    else
	printf "$install_script not found.\n" >> /dev/stderr
    fi
    ;;

RHEL)
    service="$1"
    printf "Disabling $service...\n"
    systemctl stop $service
    systemctl disable $service
    ;;

*)
    auto-unsupported-os $0
    exit 1
    ;;

esac
