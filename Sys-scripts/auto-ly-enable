#!/bin/sh -e

##########################################################################
#   Name:
#       auto-ly-enable - Enable the "ly" display manager
#
#   Section:
#       8
#
#   Synopsis:
#       auto-ly-enable
#       
#   Description:
#       The
#       .B auto-ly-enable
#       command
#       
#   Arguments:
#       None
#       
#   Returns:
#       0 on success, non-zero error codes otherwise.
#
#   Examples:
#       auto-ly-enable
#
#   See also:
#       auto-admin(8), auto-xdm-toggle(8)
#
#   History:
#   Date        Name        Modification
#   2026-10-14  Jason Bacon Add man page template and usage
##########################################################################

case $(auto-ostype) in
FreeBSD)
    pkg install -y ly
    if ! fgrep -q 'Ly:' /etc/gettytab; then
	cat << EOM >> /etc/gettytab

# Added by $0
Ly:\\
    :lo=/usr/local/bin/ly:\\
    :al=root:
# End $0 addition
EOM
    fi
    
    # FIXME: This will break of "Pc" default is changed
    sed -i '' -e '/^ttyv1/s|Pc|Ly|' /etc/ttys
    kill -HUP 1
    ;;

*)
    auto-unsupported-os $0
    exit 1
    ;;

esac
