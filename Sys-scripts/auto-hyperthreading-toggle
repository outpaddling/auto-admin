#!/bin/sh -e

##########################################################################
#   Name:
#       auto-hyperthreading-toggle - Enable or disable Intel hyperthreading
#
#   Section:
#       8
#
#   Synopsis:
#       auto-hyperthreading-toggle state
#       
#   Description:
#       The
#       .B auto-hyperthreading-toggle
#       command enables or disables hyperthreading (Intel's brand of
#       SMT (simultaneous multithreading), using a boot-time variable
#       set in /boot/loader.conf.  A reboot is required to make the
#       change take effect.
#       
#   Arguments:
#       state   "on" or "off"
#       
#   Returns:
#       0 on success, non-zero error codes otherwise.
#
#   Examples:
#       auto-hyperthreading-toggle
#
#   Files:
#       /boot/loader.conf
#
#   See also:
#       auto-admin(8), loader.conf(5)
#
#   History:
#   Date        Name        Modification
#   2026-11-26  Jason Bacon Add man page template
##########################################################################

usage()
{
    printf "Usage: $0 on|off\n"
    exit 1
}


##########################################################################
#   Function description:
#       Pause until user presses return
##########################################################################

pause()
{
    local junk
    
    printf "Press return to continue..."
    read junk
}


##########################################################################
#   Main
##########################################################################

# FIXME: Does this work on AMD processors?  Should it then be renamed
#        auto-smt-toggle?

if [ $# != 1 ]; then
    usage
fi
state=$1

case $(auto-ostype) in
FreeBSD)
    if [ $state = on ]; then
	auto-set-conf-var machdep.hyperthreading_allowed 1 /boot/loader.conf $0
    elif [ $state = off ]; then
	auto-set-conf-var machdep.hyperthreading_allowed 0 /boot/loader.conf $0
    else
	usage
    fi
    printf "Hyperthreading will be $state after the next reboot.\n"
    printf "Edit /boot/loader.conf to change.\n"
    ;;

RHEL|Linux)
    cat << EOM

Linux does not provide a simple way to disable hyperthreading.  It is best
to disable it in the BIOS if you are running Linux.

EOM
    pause
    exit 0
    ;;

*)
    auto-unsupported-os $0
    exit 1
    ;;

esac
