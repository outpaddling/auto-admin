#!/bin/sh -e

##########################################################################
#   Name:
#       auto-passwd-user-expiration - Set password expiration for a user
#
#   Section:
#       8
#
#   Synopsis:
#       auto-passwd-user-expiration username expire-days [warning-days]
#       
#   Description:
#       The
#       .B auto-passwd-user-expiration
#       command sets an individual user's password expiration to
#       the number of days specified.  If a third argument is
#       provided, the user will receive a warning that many days
#       before password expiration.
#       
#   Arguments:
#       username        The user whose password should expire
#       expire-days     Number of days before the password expires
#       warning-days    Number of days before expiration to warn the user
#       
#   Returns:
#       0 on success, non-zero error codes otherwise.
#
#   Examples:
#       auto-passwd-user-expiration
#
#   See also:
#       auto-admin(8), pw(8) [FreeBSD], chage(8) [Linux]
#
#   History:
#   Date        Name        Modification
#   2017-04-01  J Bacon     Begin
#   2026-10-16  Jason Bacon Add man page template and usage
##########################################################################

usage()
{
    printf "Usage: $0 user-name expire-days [warning-days, default=14]\n"
    exit 1
}


##########################################################################
#   Main
##########################################################################

case $# in
2)
    warning=14
    ;;
3)
    warning=$3
    ;;
*)
    usage
esac
user_name=$1
days=$2

ostype=`auto-ostype`
case $ostype in
FreeBSD)
    # FIXME: Warning days unused.  Can this be controlled?
    pw usermod $user_name -p +${days}d
    pw usershow $user_name -P
    ;;
RHEL)
    chage -M $days -W $warning $user_name
    chage -l $user_name
    ;;
*)
    printf "$0: Not yet implemented for $ostype.\n"
    exit 1
esac
