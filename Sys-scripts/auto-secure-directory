#!/bin/sh -e

##########################################################################
#   Name:
#       auto-secure-directory - Traverse a directory tree for security issues
#
#   Section:
#       8
#
#   Synopsis:
#       auto-secure-directory directory
#       
#   Description:
#       The
#       .B auto-secure-directory
#       command traverses the filesystem tree at and below directory,
#       looking for common security issues such as world-writable files.
#       Any files with security issues are printed to the standard output.
#       
#   Arguments:
#       directory   Top-level directory under which the tree is traversed
#       
#   Returns:
#       Currently always exits with 0 status.  Check output for results.
#
#   Examples:
#       auto-secure-directory
#
#   See also:
#       auto-admin(8)
#
#   History:
#   Date        Name        Modification
#   2018-10-15  Jason Bacon Begin
#   2026-10-27  Jason Bacon Add man page template and usage
##########################################################################

usage()
{
    printf "Usage: $0 top-level-directory\n"
    exit 1
}


##########################################################################
#   Main
##########################################################################

if [ $# != 1 ]; then
    usage
fi

dir="$1"

# Find world-writable files and fix them
# Leave a note for the user explaining the proper way to share access
cat << EOM

World-writable files are a major security risk, since any other user on
the system can modify them, possibly turning them into Trojan horses
(malicious programs).

EOM
printf "Checking for world-writable files...\n"
find "$dir" -perm -o+w -a \! -type l -exec chmod o-w '{}' \; -exec echo '{}' \;
