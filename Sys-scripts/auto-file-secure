#!/bin/sh -e

##########################################################################
#   Name:
#       auto-file-secure - Error out if a file is writable by non-root users
#
#   Section:
#       8
#
#   Synopsis:
#       auto-file-secure path
#       
#   Description:
#       The
#       .B auto-file-secure
#       command prints an error message and exits with an error if
#       "path" is writeble by non-root users.
#       This is meant to be run from programs that run as root, to ensure
#       that they do not run other programs that could have been modified by
#       non-root users.  It adds a level or protection against Trojan
#       horses.
#       
#   Arguments:
#       path    Absolute or relative path of the file to be checked
#       
#   Returns:
#       0 if path exists and is only writeble by root, non-zero error codes otherwise.
#
#   Examples:
#       auto-file-secure /usr/local/libexec/plugin
#
#   See also:
#       auto-admin(8), ls(1)
#
#   History:
#   Date        Name        Modification
#   2015-05-23  Jason Bacon Begin
#   2026-11-22  Jason Bacon Add man page template
##########################################################################

usage()
{
    printf "Usage: $0 filename\n"
    exit 1
}


##########################################################################
#   Function description:
#       Check security of a file
#
#   Arguments:
#       path
#       
#   Returns:
#       0 if secure, non-zero otherwise
#       
#   History:
#   Date        Name        Modification
#   2026-11-22  Jason Bacon Begin
##########################################################################

check_secure()
{
    if [ $# != 1 ]; then
	printf "Usage: check_secure path\n"
	exit 1
    fi
    
    localfile=$1
    status=0
    
    perms=`ls -ld $localfile`
    file_type=`printf '%s' $perms | cut -c 1-1`
    owner=`ls -ld $localfile | awk '{ print $3 }'`
    group=`ls -ld $localfile | awk '{ print $4 }'`
    
    # FIXME: Check permissions and suid bits
    
    if [ $owner != root ] || [ $group != root ] && [ $group != wheel ] && [ $group != bin ]; then
	printf "$0: $localfile is not owned by root:root or root:wheel or root:bin.\n"
	ls -ld $localfile
	status=1
    fi
    
    group_write=`printf '%s' $perms | cut -c 6-6`
    if [ $group_write != '-' ]; then
	printf "$0: $localfile is group writable!\n"
	status=1
    fi
    
    world_write=`printf '%s' $perms | cut -c 9-9`
    if [ $world_write != '-' ]; then
	printf "$0: $localfile is world writable!\n"
	status=1
    fi
    
    return $status
}


##########################################################################
#   Main
##########################################################################

if [ $# != 1 ]; then
    usage
fi
filename=$1

if [ ! -e $filename ]; then
    printf "$0: $filename: No such file or directory.\n"
    exit 1
fi
check_secure $filename
status=$?

if [ $status = 0 ] && [ $file_type = 'l' ]; then
    # To get file linked to portably, print last field of ls -ld
    filename2=$(ls -ld $filename | awk '{ print $NF }')
    printf "$0: $filename is secure, but a symbolic link to $filename2...\n"
    # Not all platforms have realpath command
    if [ $(echo $filename2 | cut -c 1) = '/' ]; then
	check_secure $filename2
    else
	check_secure $(dirname $filename)/$filename2
    fi
    status=$?
fi

exit $status
