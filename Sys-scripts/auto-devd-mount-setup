#!/bin/sh -e

##########################################################################
#   Name:
#       auto-devd-mount-setup - Install and configure devd-mount
#
#   Section:
#       8
#
#   Synopsis:
#       auto-devd-mount-setup
#       
#   Description:
#       The
#       .B auto-devd-mount-setup
#       command installs and enables devd-mount and related tools npmount(1)
#       and qmediamanager(1) on FreeBSD systems.  These three tools work
#       together to automatically mount removable media and display a menu
#       when they are attached to the system.  The menu provides options
#       such as opening the media in a file manager, reformatting, copying an
#       image to the media, and unmounting.
#
#       Note: The same script configures devpub-mount(1) on NetBSD.
#
#   Arguments:
#       None
#       
#   Returns:
#       0 on success, non-zero error codes otherwise.
#
#   See also:
#       auto-admin(8)
#
#   History:
#   Date        Name        Modification
#   2026-11-12  Jason Bacon Add man page template
##########################################################################

usage()
{
    printf "Usage: $0\n"
    exit 1
}


##########################################################################
#   Main
##########################################################################

if [ $# != 0 ]; then
    usage
fi

case $(auto-ostype) in
FreeBSD)
    auto-fusefs-install
    # devd-mount is a replacement for automount.  They cannot coexist.
    pkg remove -y automount || true
    pkg install -y devd-mount npmount qmediamanager
    # FIXME: Should devd-mount use devd-mount.conf instead?
    cat << EOM > /usr/local/etc/automount.conf
FM=/usr/local/bin/qmediamanager
MNT_GROUP=operator
MNT_MODE=775
EOM
    service devd restart
    ;;

NetBSD)
    auto-fusefs-install
    # These may not be available in binary packages yet
    # Install from wip if necessary
    pkgin -y install devpub-mount npmount qmediamanager || true
    cp -f $(auto-pkgsrc-prefix)/share/devpub-mount/03-devpub-mount /libexec/devpubd-hooks/
    chmod 555 /libexec/devpubd-hooks/03-devpub-mount
    auto-enable-service devpubd $0
    ;;

*)
    auto-unsupported-os $0
    exit 1
    ;;

esac
