#!/bin/sh -e

##########################################################################
#   Name:
#       auto-webcam-setup - Install and configure webcam software
#
#   Section:
#       8
#
#   Synopsis:
#       auto-webcam-setup
#       
#   Description:
#       The
#       .B auto-webcam-setup
#       command installs and configures the necessary software to enable
#       webcam devices.
#       
#   Arguments:
#       None
#       
#   Returns:
#       0 on success, non-zero error codes otherwise.
#
#   Examples:
#       auto-webcam-setup
#
#   See also:
#       auto-admin(8)
#
#   History:
#   Date        Name        Modification
#   2022-07-12  J Bacon     Begin
#   2026-11-05  Jason Bacon Add man page template
##########################################################################

usage()
{
    printf "Usage: $0\n"
    exit 1
}


##########################################################################
#   Main
##########################################################################

if [ $# != 0 ]; then
    usage
fi
	
case $(auto-ostype) in
FreeBSD)
    if ! dmesg | egrep -iq '^ugen.*Webcam|^ugen.*camera'; then
	printf "No webcam detected.  Install a webcam and run $0 again.\n"
	exit 1
    fi
    
    # https://www.davidschlachter.com/misc/freebsd-webcam-browser
    LOADER_CONF=/boot/loader.conf
    RC_CONF=/etc/rc.conf
    pkg install -y webcamd pwcview v4l-utils v4l_compat
    
    # Load cuse now and at reboot
    kldload cuse || true
    auto-set-conf-var cuse_load '"YES"' $LOADER_CONF $0

    # Enable and start webcamd
    auto-enable-service webcamd $0

    # Restart devd
    auto-enable-service devd $0
    sleep 2
    
    dmesg | grep ^ugen | grep -E -i 'Webcam|camera' | sort | uniq
    while [ -z "$ugen" ]; do
	printf "ugen device? (e.g. 1.5) "
	read ugen
    done
    auto-append-line webcamd_0_flags "webcamd_0_flags=\"-d ugen$ugen\"" \
	$RC_CONF $0
    service devd restart
    service webcamd restart
    user_name='x'
    printf "You must authorize users by adding them to the webcamd group.\n"
    while [ -n "$user_name" ]; do
	printf "Username to use webcam? (Press Enter to skip) "
	read user_name
	if [ -n "$user_name" ]; then
	    pw groupmod webcamd -m $user_name
	fi
    done
    printf "Run pwcview -d /dev/video0 to test.\n"
    ;;

*)
    # FIXME: Make auto-unsupported-os return 1?
    auto-unsupported-os $0
    exit 1
    ;;

esac
