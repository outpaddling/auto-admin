#!/bin/sh -e

#   Description:
#       Disable file transfer commands.
#       Useful on cluster head nodes.

usage()
{
    printf "Usage: $0\n"
    exit 1
}


##########################################################################
#   Main
##########################################################################

if [ $# != 0 ]; then
    usage
fi

case $(auto-ostype) in
RHEL)
    chmod o-rwx /usr/bin/scp /usr/bin/sftp /usr/bin/rsync
    ;;
    
*)
    auto-unsupported-os $0
    exit 1
    ;;

esac
