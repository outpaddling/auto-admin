#!/bin/sh -e

##########################################################################
#   Name:
#       auto-wacom-setup - Install and enable Wacom X11 driver
#
#   Section:
#       8
#
#   Synopsis:
#       auto-wacom-setup
#       
#   Description:
#       The
#       .B auto-wacom-setup
#       command installs and enables the Wacom X11 driver.  It also
#       performs a minimal webcamd daemon setup, which is necessary to
#       support Wacom devices.  This requires authorizing individual
#       users by adding them to the webcamd group.
#
#       To enable a webcam device, see auto-webcam-setup(8).
#       
#   Arguments:
#       None
#       
#   Returns:
#       0 on success, non-zero error codes otherwise.
#
#   See also:
#       auto-admin(8), auto-webcamd-setup(8), wacom(4x), webcamd(8)
#
#   History:
#   Date        Name        Modification
#   2022-07-12  J Bacon     Begin
#   2026-11-05  Jason Bacon Add man page template
##########################################################################

usage()
{
    printf "Usage: $0\n"
    exit 1
}


##########################################################################
#   Main
##########################################################################

if [ $# != 0 ]; then
    usage
fi
	
case $(auto-ostype) in
FreeBSD)
    if pkg info --exists xorg-server; then
	X11_PREFIX=''
    elif pkg info --exists xlibre-server; then
	X11_PREFIX='xlibre-'
    else
	selection=''
	while [ 0"$selection" != 01 ] && [ 0"$selection" != 02 ]; do
	    cat << EOM
1.. Xorg
2.. Xlibre
EOM
	read selection
	done
    fi
    case $selection in
    1)
	X11_PREFIX=''
	;;
    2)
	X11_PREFIX='xlibre-'
	;;
    esac
    
    # pkg-message:
    # moused(8) may interfere with tablet input by attaching to fake /dev/ums*.
    # To prevent that add a usb_quirk(4) then detach and attach the tablet.
    # /usr/local/etc/rc.d/wacom is an example how preserve quirks across reboot.

    ##########################################################################
    #   The code below is somewhat redundant to auto-webcamd-setup, but
    #   does not detect and enable a webcam device.  It is the minimum
    #   necessary to support the wacom driver.
    ##########################################################################
    
    # https://www.davidschlachter.com/misc/freebsd-webcam-browser
    LOADER_CONF=/boot/loader.conf
    RC_COND=/etc/rc.conf
    pkg install -y webcamd libwacom ${X11_PREFIX}xf86-input-wacom
    
    # Load cuse now and at reboot
    kldload cuse || true
    auto-set-conf-var cuse_load '"YES"' $LOADER_CONF $0

    # Enable and start webcamd
    auto-enable-service webcamd $0

    # Restart devd
    auto-enable-service devd $0
    service devd restart
    
    # Add users to webcamd to allow access to tablet
    user_name='x'
    printf "You must authorize users by adding them to the webcamd group.\n"
    while [ -n "$user_name" ]; do
	printf "Username to use webcam? (Press Enter to skip) "
	read user_name
	if [ -n "$user_name" ]; then
	    pw groupmod webcamd -m $user_name
	fi
    done
    ;;

*)
    # FIXME: Make auto-unsupported-os return 1?
    auto-unsupported-os $0
    exit 1
    ;;

esac
