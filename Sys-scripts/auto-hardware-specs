#!/bin/sh -e

##########################################################################
#   Name:
#       auto-hardware-specs - Display basic hardware specs
#
#   Section:
#       8
#
#   Synopsis:
#       auto-hardware-specs
#       
#   Description:
#       The
#       .B auto-hardware-specs
#       command displays basic hardware specs regarding the BIOS, motherboard,
#       CPUs, and memory on the terminal.  Information is retrieved using
#       dmidecode and displayed in standard format.  To utilize the information
#       in a program, the output must be parsed.
#       
#   Arguments:
#       None
#       
#   Returns:
#       0 on success, non-zero error codes otherwise.
#
#   See also:
#       auto-admin(8), dmidecode(8)
#
#   History:
#   Date        Name        Modification
#   2026-11-26  Jason Bacon Add man page template
##########################################################################

usage()
{
    printf "Usage: $0\n"
    exit 1
}


##########################################################################
#   Main
##########################################################################

if [ $# != 0 ]; then
    usage
fi

auto-root-check $0 "It needs access to /dev/mem.\n"

if ! which dmidecode > /dev/null 2>&1; then
    printf "You must install dmidecode to use $0.\n"
    exit 1
fi

printf "BIOS:\n"
dmidecode -t bios | egrep 'Vendor|Version'

printf "\nSystem:\n"
dmidecode -t system | egrep 'Manufacturer|Product|Serial|UUID'

printf "\nBase board:\n"
dmidecode -t baseboard | egrep 'Manufacturer|Product|Version|Serial'

printf "\nCPUs:\n"
dmidecode -t processor | egrep 'Socket|Version|Speed|Core|Thread'

printf "\nMemory:\n"
dmidecode -t memory | egrep 'Capacity|Size|Locator|Type|Speed.*MT'

cat << EOM

Run dmidecode directly for more detailed information.

EOM
