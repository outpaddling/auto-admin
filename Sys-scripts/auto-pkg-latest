#!/bin/sh -e

##########################################################################
#   Name:
#       auto-pkg-latest - Switch from snapshot to latest packages
#
#   Section:
#       8
#
#   Synopsis:
#       auto-pkg-latest [--no-restart] [--yes]
#       
#   Description:
#       The
#       .B auto-pkg-latest
#       command switches the binary package repository and ports tree to
#       use the latest packages.  All currently installed packages are
#       upgraded and all future port/package installations will be from
#       the latest collection.
#
#       This should be done with caution, since switching back to snapshots
#       can be problematic.  E.g., if the latest version of a package
#       uses a newer configuration file format than the one in the
#       most recent ports snapshot, the software may see the configuration
#       file as corrupt.
#       
#   Arguments:
#       --no-restart    Don't prompt to restart services after upgrades
#       --yes           Don't warn about consequences of upgrading
#       
#   Returns:
#       0 on success, non-zero error codes otherwise.
#
#   See also:
#       auto-admin(8)
#
#   History:
#   Date        Name        Modification
#   2019-06-16  Jason Bacon Begin
#   2026-10-21  Jason Bacon Add man page template and usage
##########################################################################

usage()
{
    printf "Usage: $0 [--no-restart] [--yes]\n"
    exit 1
}


##########################################################################
#   Main
##########################################################################

case $(auto-ostype) in
FreeBSD)
    while [ 0$(echo $1 | cut -c 1,2) = 0'--' ]; do
	if [ 0$1 = 0'--help' ]; then
	    usage
	elif [ 0$1 = 0'--no-restart' ]; then
	    no_restart=1
	    shift
	elif [ 0$1 = 0'--yes' ]; then
	    proceed=1
	    shift
	else
	    usage
	fi
    done

    dir=/usr/local/etc/pkg/repos
    file=$dir/bleeding-edge.conf

    if pkg repositories -e | grep -q 'url.*: .*/latest' \
	&& pkg repositories -e | grep -q 'url.*: .*/kmods_latest'; then
	printf "$0: You are already using latest packages.\n"
	printf "Overwrite $file? y/[n] "
	read overwrite
	if [ 0"$overwrite" != 0y ]; then
	    exit 0
	fi
    fi
    if [ 0$proceed != 01 ]; then
	cat << EOM

			       *** WARNING ***
				 
Switching from quarterly to latest is not easily reversible.  Once applications
such as Firefox, Chromium, and Thunderbird are upgraded to the latest release,
their configuration files may not be readable to older versions present in
the quarterly branch.

Also be aware that you will likely experience occasional regressions (new bugs)
when using the latest packages.  You can be of service to the FreeBSD project
by using the latest packages and reporting regressions you encounter.  If it
is more important that software on this system be as stable as possible, you
may want to stay with the quarterly packages instead.

EOM
	printf "Are you sure you want to switch to latest? y/n [n] "
	read proceed
	if [ 0$proceed != 0y ]; then
	    exit
	fi
    fi
    
    mkdir -p $dir
    if [ $(uname -K) -ge 1500000 ]; then
	ports_repo_insert="-ports"
    else
	ports_repo_insert=""
    fi
    # FIXME: Verify suffix for all branch types
    if uname -r | grep -E 'BETA|RC|RELEASE'; then
	kmods_suffix='_${VERSION_MINOR}'
    else
	kmods_suffix=""
    fi
    cat << EOM > $file
FreeBSD$ports_repo_insert: {
  url: "pkg+https://pkg.FreeBSD.org/\${ABI}/latest",
  mirror_type: "srv",
  signature_type: "fingerprints",
  fingerprints: "/usr/share/keys/pkg",
  enabled: yes
}
FreeBSD$ports_repo_insert-kmods: {
  url: "pkg+https://pkg.FreeBSD.org/\${ABI}/kmods_latest$kmods_suffix",
  mirror_type: "srv",
  signature_type: "fingerprints",
  fingerprints: "/usr/share/keys/pkg",
  enabled: yes,
  priority: 1
}
EOM
    pkg upgrade -y
    auto-check-ports-branch
    
    if [ 0$no_restart != 01 ]; then
	printf "Restart services? (y/n) [y] "
	read restart
	if [ 0$restart != 0n ]; then
	    auto-restart-services
	fi
    fi
    ;;
    
*)
    auto-unsupported-os $0
    exit 1
    ;;

esac
