#!/bin/sh

##########################################################################
#   Name:
#       auto-fix-date - Synchronize an incorrect system clock
#
#   Section:
#       8
#
#   Synopsis:
#       auto-fix-date
#       
#   Description:
#       The
#       .B auto-fix-date
#       command corrects the system date.  Services such as ntpd(8)
#       will fail to correct a clock that has strayed too far, since they will
#       only make small incremental corrections in order to avoid confusing
#       other processes.
#
#       The ntpdate(8) command instantly corrects the system clock, but
#       cannot run while ntpd(8) is running.
#       The auto-fix-date script is a convenience that temporarily
#       stops ntpd(8), runs ntpdate(8), and restarts ntpd(8).
#       
#   Arguments:
#       None
#       
#   Returns:
#       0 on success, non-zero error codes otherwise.
#
#   See also:
#       auto-admin(8), ntpd(8), ntpdate(8)
#
#   History:
#   Date        Name        Modification
#   2020-12-23  Jason Bacon Begin
#   2026-11-24  Jason Bacon Add man page template
##########################################################################

usage()
{
    printf "Usage: $0\n"
    exit 1
}


##########################################################################
#   Main
##########################################################################

if [ $# != 0 ]; then
    usage
fi

case $(auto-ostype) in
DragonFly|FreeBSD|NetBSD)
    # Use absolute pathnames with su to avoid malicious programs
    printf "Root "
    su -m root -c '/usr/sbin/service ntpd stop; /usr/sbin/ntpdate -u pool.ntp.org; /usr/sbin/service ntpd start'
    ;;

*)
    # To-do: auto-detect chronyd or ntp on RHEL
    auto-unsupported-os $0
    exit 1
    ;;

esac
