#!/bin/sh -e

##########################################################################
#   Name:
#       auto-service-enabled - Exit 0 if the indicated service is enabled
#
#   Section:
#       8
#
#   Synopsis:
#       auto-service-enabled service-name
#       
#   Description:
#       The
#       .B auto-service-enabled
#       command exits with 0 (success) status if "service-name" is
#       currently enabled.  This is meant to be run in conditionals
#       in scripts.
#
#       Note: The service name used here is the name of the service
#       as specified to underlying native commands such as "service"
#       or "systemctl".
#       
#   Arguments:
#       service-name    Name of the service
#       
#   Returns:
#       0 if the service is enabled, non-zero otherwise
#
#   Examples:
#       if auto-service-enabled sshd; then
#           ...
#       fi
#
#   See also:
#       auto-admin(8)
#
#   History:
#   Date        Name        Modification
#   2024-10-21  Izzy Meyer  Add OpenBSD support
#   2026-10-31  Jason Bacon Add man page template and usage
##########################################################################

if [ $# != 1 ]; then
    printf "Usage: $0 service-name\n"
    exit 1
fi
    
case $(auto-ostype) in
DragonFly|FreeBSD)
    script=$1
    # As of 2026-10-31, "service name status" does not distinguish
    # between stopped and running services.  Both are reported as "not running".
    # So, we have to extract rcvar from the service script and check it
    # in rc.conf.
    for dir in /etc/rc.d /usr/local/etc/rc.d; do
	if [ -e $dir/$script ]; then
	    if grep -q '^rcvar=' $dir/$script; then
		service=$(grep '^rcvar=' $dir/$script | tail -1 | cut -d = -f 2)
	    else
		service=$script
	    fi
	    printf "rc service name = $service\n"
	    break
	fi
    done
    grep -q "^${service}=.*YES.*" /etc/rc.conf
    exit $?
    ;;
    
NetBSD)
    service=$1
    grep -q "^${service}=.*YES.*" /etc/rc.conf
    exit $?
    ;;

OpenBSD)
    service=$1
    rcctl ls on | grep -q "${service}"
    exit $?
    ;;

*)
    auto-unsupported-os $0
    exit 1
    ;;

esac
