#!/bin/sh -e

##########################################################################
#   Name:
#       auto-change-primary-group - Change the primary group of a user
#
#   Section:
#       8
#
#   Synopsis:
#       auto-change-primary-group username new-group|new-gid [directory]
#       
#   Description:
#       The
#       .B auto-change-primary-group
#       command changes the primary group of "username" to "new-group"
#       or to the numeric GID "new-gid".
#
#       If one or more "directory" arguments are provided,
#       .B auto-change-primary-group
#       runs auto-change-group-ownership(8) on each directory to update
#       group ownership of relevant files under the directory.
#
#       Note: No group ownerships are updated unless at least one directory is
#       explicitly indicated.  This allows ownership correction, which
#       is time-consuming, to be done separately if desired.
#       
#   Arguments:
#       username            Username of the user whose primary group is to change
#       new-group|new-gid   New group name or numeric GID
#       directory           Optional directory to traverse, updating files
#       
#   Returns:
#       0 on success, non-zero error codes otherwise.
#
#   Examples:
#       auto-change-primary-group joeuser joesgroup /home/joeuser
#
#   Files:
#       /etc/passwd, /etc/group
#
#   See also:
#       auto-admin(8)
#       auto-add-group(8), auto-add-to-group(8), auto-group-check(8), 
#       auto-change-group-gid(8), auto-remove-from-group(8), 
#       auto-change-group-ownership(8), chgrp(8)
#
#   History:
#   Date        Name        Modification
#   2026-11-11  Jason Bacon Add man page template
##########################################################################

usage()
{
    printf "Usage: $0 username new-group|new-gid [directory ...]\n"
    exit 1
}


##########################################################################
#   Main
##########################################################################

if [ `id -un` != 'root' ]; then
    printf "Only root can run $0.\n"
    exit 1
fi

if [ $# -lt 2 ]; then
    usage
fi

user_name=$1
new_group=$2
shift
shift

# Verify that all dirs exits before changing anything!
dirs="$@"
for dir in $dirs; do
    if [ ! -e $dir ]; then
	printf "$0: ${dir}: No such file or directory.\n"
	exit 1
    fi
done

# Verify that user exists
old_gid=`awk -F : -v user_name=$user_name '$1 == user_name { print $4 }' /etc/passwd`
if [ 0$old_gid = 0 ]; then
    printf "$0: $user_name: No such user.\n"
    exit 1
fi

if awk -F : '{ print $1 }' /etc/group | fgrep -q $new_group; then
    new_gid=`awk -F : -v group_name=$new_group '$1 == group_name { print $3 }' /etc/group`
elif awk -F : '{ print $3 }' /etc/group | fgrep -q $new_group; then
    new_gid=$new_group
else
    printf "$0: Error: $new_group is not an existing group.\n"
    exit 1
fi

if [ $old_gid = $new_gid ]; then
    printf "$0: $new_group is already the primary group for $user_name.\n"
    exit
fi

# Verify that new gid exists: Let usermod handle this, or we'll have to
# check for both group name and gid.

# Call me from cluster-change-gid
case $(auto-ostype) in
DragonFly|FreeBSD)
    pw usermod $user_name -g $new_group
    ;;

NetBSD|RHEL)
    usermod -g $new_group $user_name
    ;;

*)
    auto-unsupported-os $0
    exit 1
    ;;

esac

# Change group ownership on files under specified directories
if [ 0"$dirs" != 0 ]; then
    auto-change-group-ownership $user_name $old_gid $new_group $dirs
fi
